<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PhoneTasks.uss?fileID=7433441132597879392&amp;guid=7a874a7de6564466eb2a44ce8e6824c8&amp;type=3#PhoneTasks" />
    <ui:VisualElement name="phone-root" class="phone-root" style="flex-grow: 1;">
        <ui:VisualElement name="header" class="header" style="flex-grow: 1;">
            <ui:Button text="X" name="exit-button" class="exit-button" />
            <ui:Label text="My Tasks" name="header-title" class="header-title" />
        </ui:VisualElement>
        <ui:VisualElement name="TaskGrid" class="task-grid" style="flex-grow: 1;">
            <ui:VisualElement name="TaskSlot1" class="task-box" style="flex-grow: 1;">
                <ui:Label name="Task1" emoji-fallback-support="true" class="task-label" />
            </ui:VisualElement>
            <ui:VisualElement name="TaskSlot2" class="task-box" style="flex-grow: 1;">
                <ui:Label text="IMTC 505 Assignment (Due Tomorrow)" name="Task2" class="task-label" />
            </ui:VisualElement>
            <ui:VisualElement name="TaskSlot3" class="task-box" style="flex-grow: 1;">
                <ui:Label text="COSC 520 Project (Due in 2 days)" name="Task3" emoji-fallback-support="false" class="task-label" style="align-content: flex-start; align-self: flex-start; width: 154px; height: 24px; align-items: center;" />
            </ui:VisualElement>
            <ui:VisualElement name="TaskSlot4" class="task-box" style="flex-grow: 1;">
                <ui:Label text="Seminar Presentation (Due Tomorrow)" name="Task4" selectable="true" focusable="true" emoji-fallback-support="false" class="task-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="NewTaskSection" class="new-task-section" style="flex-grow: 1;">
            <ui:Label text="New Tasks" name="NewTaskLabel" class="new-task-label" />
            <ui:VisualElement name="NewTaskGrid" class="new-task-grid" style="flex-grow: 1;">
                <ui:VisualElement name="NewTaskSlot1" class="task-box" style="flex-grow: 1;" />
                <ui:VisualElement name="NewTaskSlot2" class="task-box" style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
