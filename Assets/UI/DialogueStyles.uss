/* Main Container */
.container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 80px;
}

/* NPC Speech Bubble */
.speech-bubble {
    background-color: rgba(50, 50, 60, 0.95);
    border-color: rgba(150, 150, 170, 0.6);
    border-width: 3px;
    border-radius: 20px;
    padding: 25px 35px;
    margin-bottom: 20px;
    max-width: 600px;
    min-height: 80px;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.bubble-text {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-wrap: wrap;
}

/* Choices Row Container */
.choices-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.3s;
}

/* Choice Buttons */
.choice-button {
    background-color: rgba(30, 50, 80, 0.95);
    border-color: rgba(70, 130, 220, 0.8);
    border-width: 3px;
    border-radius: 15px;
    padding: 20px 40px;
    margin: 0 15px;
    min-width: 250px;
    min-height: 80px;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s, 0.2s, 0.2s;
    scale: 1 1;
}

.choice-button:hover {
    scale: 1.1 1.1;
    background-color: rgba(50, 90, 150, 0.98);
    border-color: rgba(100, 180, 255, 1);
}

.choice-button:active {
    background-color: rgba(60, 110, 180, 1);
    border-color: rgba(120, 200, 255, 1);
}

.choice-text {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Highlighted state */
.choice-highlighted {
    background-color: rgba(50, 90, 150, 0.98);
    border-color: rgba(100, 180, 255, 1);
    scale: 1.1 1.1;
}

/* Hidden state */
.choice-hidden {
    display: none;
}